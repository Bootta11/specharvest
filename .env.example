# --- Server ---
PORT=3100
# SQLite DB, LanceDB vectors and the embedding model cache live here.
DATA_DIR=./data

# Encrypts the LLM API keys users add (avatar menu → LLM provider): 32 random bytes, base64 or hex.
#   openssl rand -base64 32
# Blank = generated once into DATA_DIR/encryption.key. Keep a copy: without it, stored keys can't be read.
ENCRYPTION_KEY=

# --- Server LLM key: OpenRouter (https://openrouter.ai/keys) ---
# Runs work for users without a key of their own (admins choose who may use it: Users & sign-up).
# Optional when everyone brings their own key. See docs/llm-providers.md.
OPENROUTER_API_KEY=
# Listing detection + search query parsing
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# Per-item spec extraction (blank = OPENROUTER_MODEL)
OPENROUTER_EXTRACTION_MODEL=
# Web lookups for missing specs (blank = OPENROUTER_SMART_MODEL)
OPENROUTER_WEB_MODEL=
# Merging duplicate spec keys (needs better judgement than the cheap model)
OPENROUTER_SMART_MODEL=google/gemini-2.5-flash
# Retries and timeout for every LLM call (users' own keys too)
OPENROUTER_MAX_RETRIES=3
OPENROUTER_TIMEOUT_MS=90000
# Optional management key (https://openrouter.ai/settings/management-keys) —
# only used to show the account credit balance to admins. Blank = key info only.
OPENROUTER_MANAGEMENT_KEY=

# --- Web enrichment (provider web search; engine/max uses apply to OpenRouter) ---
WEB_SEARCH_ENABLED=true
# auto | native | exa | parallel | perplexity | firecrawl
WEB_SEARCH_ENGINE=auto
# Searches one lookup may run (each costs ~$0.007)
WEB_SEARCH_MAX_USES=1
# Max web lookups (distinct product identities) per enrichment job
ENRICH_MAX_LOOKUPS=15
# Extra likely-wanted attributes asked for in the same paid lookup and cached (0 = off)
ENRICH_PREFETCH_MAX=12
# Start enrichment when fewer than this share of candidates have the key
ENRICH_COVERAGE_THRESHOLD=0.8
# Web answers below this confidence are cached as "not found"
ENRICH_MIN_CONFIDENCE=0.6
# Retry "not found" web answers after this many days (0 = never)
ENRICH_NOT_FOUND_TTL_DAYS=30

# --- Browser (required): remote Puppeteer/Chrome WebSocket endpoint ---
PUPPETEER_WS_ENDPOINT=ws://localhost:3000
# Auth for a gated endpoint (traefik-apikeys): X-Api-Key and/or Basic auth
PUPPETEER_WS_API_KEY=
PUPPETEER_WS_USER=
PUPPETEER_WS_PASSWORD=
# Local dev only: used when PUPPETEER_WS_ENDPOINT is blank (headless local Chrome)
PUPPETEER_EXECUTABLE_PATH=
# Optional HTTP proxy for every page load. Leave blank to disable.
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# --- Crawl limits ---
SCRAPE_MAX_CONCURRENT_PAGES=2
# Defaults when a crawl doesn't say
MAX_PAGES=10
MAX_ITEMS=200
# Most a non-admin may ask one crawl for (admins: 200 pages / 5000 items)
MAX_PAGES_CAP=50
MAX_ITEMS_CAP=1000
# Crawls + web lookups one non-admin may run at once (0 = no limit)
MAX_ACTIVE_JOBS_PER_USER=3
# Largest collection file an import accepts
IMPORT_MAX_MB=50

# --- Notifications (channels are configured in the UI: Settings) ---
# Base URL for links in notifications, e.g. https://specharvest.example (blank = no link)
PUBLIC_URL=
# Web Push keys (blank = generated once and stored in the DB)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# --- Users (see docs/auth.md) ---
# First admin, created on boot when no user exists yet (or run: npm run seed:admin -- --email you@example.com).
ADMIN_EMAIL=
# Blank = generate one and print it to the server log once.
ADMIN_PASSWORD=
# Secure flag on the session cookie. Blank = on when PUBLIC_URL is https.
SESSION_COOKIE_SECURE=
# Extra origins allowed to call the API with a bearer token, comma-separated. The Android app
# (https://localhost) is always allowed — see docs/mobile-app.md.
APP_ORIGINS=
# Which proxies may set X-Forwarded-For (the client IP for rate limits): IPs, CIDRs,
# loopback/linklocal/uniquelocal, or true/false. Blank = loopback,linklocal,uniquelocal
# (a reverse proxy or tunnel on the host or a private Docker network).
TRUST_PROXY=

# --- Outbound requests (see docs/deployment.md#security-settings) ---
# Crawls never open private/LAN/loopback addresses; true allows them (and lifts the
# notification checks for everyone) — only for a single-user LAN setup.
ALLOW_PRIVATE_TARGETS=false
# Hosts every user's notifications may reach although they're private (comma-separated).
# Admins' notifications may go anywhere. Blank = none.
OUTBOUND_ALLOWED_HOSTS=apprise
