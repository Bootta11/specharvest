<?xml version="1.0" encoding="utf-8"?>
<!-- Direct build only (the APK on Zealot): installing its own updates. The Play build never gets these. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Lets an update install without Android's confirm screen (API 31+), once this app installed the previous one. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application>
        <receiver android:name=".InstallStatusReceiver" android:exported="false" />
        <receiver android:name=".UpdateReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
